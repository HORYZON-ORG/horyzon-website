    },
    {
      "name": "patrimonial_domain_events_revision_check",
      "table": "patrimonial_domain_events",
      "validated": true,
      "definition": "CHECK ((revision >= 0))"
    },
    {
      "name": "patrimonial_domain_events_supersedes_event_id_fkey",
      "table": "patrimonial_domain_events",
      "validated": true,
      "definition": "FOREIGN KEY (supersedes_event_id) REFERENCES patrimonial_domain_events(event_id)"
    },
    {
      "name": "patrimonial_intents_check",
      "table": "patrimonial_intents",
      "validated": true,
      "definition": "CHECK (((jsonb_typeof(record) = 'object'::text) AND ((record ->> 'id'::text) = (id)::text)))"
    },
    {
      "name": "patrimonial_intents_check1",
      "table": "patrimonial_intents",
      "validated": true,
      "definition": "CHECK (((kind <> 'PROVISIONAL'::text) OR ((provisional_key IS NOT NULL) AND (group_key IS NULL))))"
    },
    {
      "name": "patrimonial_intents_check2",
      "table": "patrimonial_intents",
      "validated": true,
      "definition": "CHECK (((kind <> 'OPPORTUNITY'::text) OR ((group_key IS NOT NULL) AND (business_key IS NOT NULL) AND (location_ref IS NOT NULL) AND (remote_contact_id IS NOT NULL) AND (scope_key IS NOT NULL) AND ((record ->> 'groupKey'::text) = group_key) AND ((record ->> 'businessKey'::text) = business_key) AND (((record ->> 'revision'::text))::integer = revision) AND ((record ->> 'status'::text) = status) AND ((record ->> 'stage'::text) = stage) AND (next_step IS NOT NULL) AND (status = ANY (ARRAY['OPEN'::text, 'WON'::text, 'LOST'::text, 'ABANDONED'::text])) AND (stage IS NOT NULL) AND (next_step = ANY (ARRAY['ASSIGN'::text, 'INVITE_PRESENTATION'::text, 'BOOK_PRESENTATION'::text, 'QUALIFY'::text, 'BOOK_INTERVIEW'::text, 'RECORD_OUTCOME'::text, 'AGREE_PATH_START'::text, 'CONFIRM_EDITION'::text, 'RECORD_ATTENDANCE'::text, 'FOLLOW_UP'::text, 'BOOK_CONSULTATION'::text, 'REVIEW'::text, 'NONE'::text])) AND (((funnel = 'architect-path'::text) AND (stage = ANY (ARRAY['A01'::text, 'A02'::text, 'A03'::text, 'A04'::text, 'A05'::text, 'A06'::text, 'A07'::text, 'A08'::text, 'A09'::text, 'A10'::text]))) OR ((funnel = 'patrimonial-event'::text) AND (stage = ANY (ARRAY['E01'::text, 'E02'::text, 'E03'::text, 'E04'::text, 'E05'::text]))) OR ((funnel = 'patrimonial-consultation'::text) AND (stage = ANY (ARRAY['C01'::text, 'C02'::text, 'C03'::text, 'C04'::text, 'C05'::text])))) AND (((status = 'OPEN'::text) AND (next_step IS NOT NULL) AND (next_step <> 'NONE'::text) AND (next_step_at IS NOT NULL)) OR ((status <> 'OPEN'::text) AND (next_step = 'NONE'::text) AND (next_step_at IS NULL))) AND\nCASE\n    WHEN (stage = 'A09'::text) THEN (status = 'WON'::text)\n    WHEN (stage = 'A10'::text) THEN (status = ANY (ARRAY['LOST'::text, 'ABANDONED'::text]))\n    WHEN (stage = ANY (ARRAY['E05'::text, 'C05'::text])) THEN (status <> 'OPEN'::text)\n    ELSE (status = 'OPEN'::text)\nEND)))"
    },
    {
      "name": "patrimonial_intents_cycle_check",
      "table": "patrimonial_intents",
      "validated": true,
      "definition": "CHECK ((cycle > 0))"
    },
    {
      "name": "patrimonial_intents_funnel_check",
      "table": "patrimonial_intents",
