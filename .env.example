# Server Supabase URL; NEXT_PUBLIC_SUPABASE_URL remains a supported fallback.
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Patrimonial v2: server-only; absent/invalid values are false (only literal true enables).
# Durable adapter is implemented locally; its migration has NOT been applied.
# Readiness must stay disabled until a separately authorized DB/schema/privilege check.
# Missing URL/service role/readiness or failed schema health => v2 503, never memory/2A.
# CRM writes also require verified server-side location/routes/capabilities/tag mapping.
# Real opportunity transport is a stub; booking/messages/webhook remain unimplemented.
PATRIMONIAL_DURABLE_STORE_READY=
PATRIMONIAL_V2_ENABLED=
PATRIMONIAL_CRM_WRITE_ENABLED=
PATRIMONIAL_OPPORTUNITY_WRITE_ENABLED=
PATRIMONIAL_BOOKING_ENABLED=
PATRIMONIAL_MESSAGES_ENABLED=
PATRIMONIAL_WEBHOOK_ENABLED=
# Existing server-only HighLevel configuration; no IDs or credentials in this template.
HIGHLEVEL_PRIVATE_TOKEN=
HIGHLEVEL_LOCATION_ID=

# Shared Stripe server configuration.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Paid Radar remains fail-closed until an approved price is configured.
RADAR_PUBLIC_BASE_URL=https://horyzon.it
RADAR_STRIPE_PRICE_REPORT=
RADAR_PRICE_AMOUNT_CENTS=
RADAR_CHECKOUT_ENABLED=0
RADAR_PREVIEW_ENABLED=0
RADAR_PREVIEW_PIN=
RADAR_COOKIE_SECRET=

# Annunci 10x server runtime. MOCK is for controlled testing only; use OPENAI only with a validated production API key.
ANNUNCI10X_AI_PROVIDER=MOCK
ANNUNCI10X_PUBLIC_SCORE_VERSION=V2
ANNUNCI10X_SCORE_REPORT_EMAIL_ENABLED=1
ANNUNCI10X_EMAIL_PROVIDER=RESEND
ANNUNCI10X_EMAIL_FROM=
ANNUNCI10X_EMAIL_REPLY_TO=
ANNUNCI10X_PUBLIC_BASE_URL=https://horyzon.it
ANNUNCI10X_EMAIL_VERIFICATION_PEPPER=
RESEND_API_KEY=
OPENAI_API_KEY=
